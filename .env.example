# ==============================================================================
# VULPTO SAAS — VARIÁVEIS DE AMBIENTE (PRODUÇÃO / COOLIFY / DEMO)
# Copie para .env e preencha. NUNCA versione o .env real com credenciais.
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL no Coolify)
# Formato padrão da rede interna Docker do Coolify:
# DATABASE_URL="postgresql://postgres:SENHA@postgres:5432/vulpto?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vulpto?schema=public"
NODE_ENV=production

# 2. SEGURANÇA E SESSÕES JWT (Mínimo 32 caracteres gerados com: openssl rand -base64 48)
JWT_SECRET=
MASTER_JWT_SECRET=

# 3. GESTOR MASTER (Acesso global ao painel /gestor-master)
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# 4. DOMÍNIO E URL PÚBLICA (Traefik / Coolify)
# Ex.: https://vulpto.meudominio.com ou https://vulpto.duckdns.org
APP_URL=

# 5. INICIALIZAÇÃO DE DADOS / DEMO (Opcional)
# Defina RUN_SEED=true apenas no primeiro deploy no Coolify para carregar tenant demonstrativo
RUN_SEED=false
FORCE_SEED=false

# 6. E-MAILS TRANSACIONAIS (Recuperação de Senha & Notificações)
# Opção A (Recomendado - API Rápida): Adicione sua chave do Resend
RESEND_API_KEY=
RESEND_FROM="Vulpto <onboarding@resend.dev>"

# Opção B: SMTP Tradicional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vulpto Gestão <noreply@vulpto.com.br>"
SMTP_SECURE=false

# (Se ambos forem omitidos, o sistema entra em MODO DEMO automático:
# o link de redefinição é impresso nos logs do container e exibido em um card na própria tela)

# 7. REDIS / CACHE & RATE LIMIT DISTRIBUÍDO (Opcional)
# Se omitido, utiliza rate limit em memória RAM local com fallback transparente
REDIS_URL=

# 8. GOOGLE OAUTH (Opcional - Google Cloud Console > Credenciais)
# Redirect URI autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
