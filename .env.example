# Copie para .env e preencha. NUNCA versione o .env real.
DATABASE_URL="file:./dev.db"
NODE_ENV=development

# Obrigatório: mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=
# Opcional: segredo separado para a sessão master (padrão: derivado de JWT_SECRET)
MASTER_JWT_SECRET=

# Gestor master (sem valores padrão: se vazio, o login master fica desabilitado)
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Login com Google (Google Cloud Console > Credenciais > ID do cliente OAuth Web)
# Redirect URI autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública do app (ex.: https://vulpto.duckdns.org). Se vazio, deriva dos headers.
APP_URL="https://vulpto.duckdns.org"
